{
  "name": "open_edit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-provenance.mjs && node scripts/licenses.mjs --check",
    "audit:secrets": "node scripts/check-client-secrets.mjs",
    "gen:assets": "node --no-warnings scripts/gen-all.mjs",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "heic-to": "^1.6.7",
    "lucide": "^1.70.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "onnxruntime-web": "^1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Open_Edit: open-source camera and photo/video editor for the web",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
