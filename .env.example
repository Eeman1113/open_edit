# Open_Edit configuration. Copy to .env.local (development) or set in your host's environment.
# Every variable is optional: with none set, the app serves its built-in catalogues from the open asset pack.
# Variables without the NEXT_PUBLIC_ prefix are read only by the server and never reach the browser.

# ---------------------------------------------------------------- content providers (server only, read per request)
# One content service for every catalogue. The default "http-json" adapter calls
#   {URL}/music, /art-styles, /looks/{kind}, /stickers, /templates, /feed/{name}
# with "Authorization: Bearer {KEY}". See docs/platform.md for the response shapes.
OE_CONTENT_API_URL=
OE_CONTENT_API_KEY=
# Adapter id registered in src/server/providers/index.ts (default: http-json).
OE_CONTENT_ADAPTER=

# Per-catalogue overrides (each falls back to the OE_CONTENT_* values above).
OE_MUSIC_API_URL=
OE_MUSIC_API_KEY=
OE_MUSIC_ADAPTER=
OE_ARTSTYLE_API_URL=
OE_ARTSTYLE_API_KEY=
OE_ARTSTYLE_ADAPTER=
OE_LOOKS_API_URL=
OE_LOOKS_API_KEY=
OE_LOOKS_ADAPTER=
OE_STICKERS_API_URL=
OE_STICKERS_API_KEY=
OE_STICKERS_ADAPTER=
OE_TEMPLATES_API_URL=
OE_TEMPLATES_API_KEY=
OE_TEMPLATES_ADAPTER=
OE_FEED_API_URL=
OE_FEED_API_KEY=
OE_FEED_ADAPTER=

# Provider request timeout in ms (500-30000, default 6000). On timeout or error the local catalogue is served.
OE_PROVIDER_TIMEOUT_MS=
# In-memory cache of provider responses in seconds (0 disables, default 300).
OE_PROVIDER_CACHE_SECONDS=
# Cache-Control max-age of /api responses in seconds (0 = no-store, default 300).
OE_API_CACHE_SECONDS=

# ---------------------------------------------------------------- anonymous sessions and rate limiting (server only)
# "off" disables the anonymous session cookie (rate limits then apply per IP only).
OE_SESSIONS=
# HMAC secret that signs the session cookie, at least 32 characters. Generate one with: openssl rand -base64 48
# Without it a random secret is created per process (sessions reset on restart and differ between instances).
OE_SESSION_SECRET=
# API requests per minute per session (or per IP without one). 0 disables. Default 120.
OE_RATE_LIMIT_PER_MINUTE=
# 1 = trust X-Forwarded-For / X-Real-IP from your reverse proxy or CDN (default on Vercel, off elsewhere).
OE_TRUST_PROXY=

# ---------------------------------------------------------------- build time (baked into the build)
# Asset pack in public/packs/<id>/ (default: open).
NEXT_PUBLIC_ASSET_PACK=
# Serve the app under a sub-path, e.g. /open-edit (no trailing slash).
NEXT_PUBLIC_BASE_PATH=
# Cross-origin isolation for multithreaded WASM: credentialless (default) | require-corp | off.
OE_COEP=
