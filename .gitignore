# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test media (never commit user photos)
/public/face/_dev/
/public/dev/

# Only the built-in open asset pack is committed; other packs are licensed separately
/public/packs/*
!/public/packs/open/

# keep the documented template
!.env.example

# Build-time snapshots of the content API for static hosting (scripts/gen-static-api.mjs)
/public/api-static/
